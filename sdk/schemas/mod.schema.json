{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://san14-mod-manager.local/schemas/mod-v1.schema.json",
  "title": "SAN14 Standard Mod Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "entry",
    "host_version",
    "dependencies",
    "conflicts",
    "permissions",
    "disable_mode"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "author": {
      "type": "string",
      "maxLength": 80
    },
    "author_url": {
      "description": "Link attached to the author's name; may be an original post or homepage as specified by the author/user.",
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://[^\\s\\\\]+$"
    },
    "source_url": {
      "description": "Original publication/post provenance. It may also be the destination on the author's name; does not imply a separate UI link.",
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://[^\\s\\\\]+$"
    },
    "contributors": {
      "description": "Contributors with links attached to their names; legacy name strings remain accepted.",
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "url": {
                "type": "string",
                "maxLength": 2048,
                "pattern": "^https://[^\\s\\\\]+$"
              }
            }
          }
        ]
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "maxLength": 600
    },
    "entry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "path",
            "abi"
          ],
          "properties": {
            "type": {
              "const": "native"
            },
            "path": {
              "type": "string",
              "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+\\.[dD][lL][lL]$"
            },
            "abi": {
              "const": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "path"
          ],
          "properties": {
            "type": {
              "const": "content"
            },
            "path": {
              "type": "string",
              "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+\\.[jJ][sS][oO][nN]$"
            }
          }
        }
      ]
    },
    "host_version": {
      "type": "string",
      "minLength": 1
    },
    "game_builds": {
      "description": "Optional additional build restriction. When omitted, inherits the manager's supported game profiles; an explicit list must be nonempty.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4294967295
      }
    },
    "game_exe_sha256": {
      "description": "Exact executable FILE identities tested by this Mod. Required for game.memory.read; any declared list must match the running game.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "game.read.officers",
          "game.read.forces",
          "game.read.cities",
          "game.read.units",
          "game.read.areas",
          "game.read.saves",
          "game.commands",
          "ui.panel",
          "ui.officer-detail",
          "input.hotkey",
          "input.text",
          "storage.global",
          "storage.playthrough",
          "storage.saved-edit",
          "storage.save",
          "network",
          "game.rules",
          "settings",
          "game.memory.read",
          "game.content"
        ]
      }
    },
    "load_order": {
      "type": "integer",
      "minimum": -10000,
      "maximum": 10000,
      "default": 100
    },
    "default_enabled": {
      "type": "boolean",
      "default": false
    },
    "disable_mode": {
      "enum": [
        "hot",
        "main_menu",
        "restart"
      ]
    },
    "coauthors": {
      "description": "Additional authors in order after author, with links attached to their names.",
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^https://[^\\s\\\\]+$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "permissions": {
            "contains": {
              "const": "game.memory.read"
            }
          }
        },
        "required": [
          "permissions"
        ]
      },
      "then": {
        "required": [
          "game_exe_sha256"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "entry": {
            "properties": {
              "type": {
                "const": "content"
              }
            }
          }
        },
        "required": [
          "entry"
        ]
      },
      "then": {
        "properties": {
          "permissions": {
            "contains": {
              "const": "game.content"
            }
          }
        }
      }
    }
  ]
}
